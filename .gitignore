# ------------------------------------------------------------
# Magento 2 + Hyvä project
# Only our own code is committed: composer.json/lock, app/ (code, design, config.php),
# CLAUDE.md and .claude/. Everything else is recreated by `composer install`
# or generated by Magento at runtime.
# ------------------------------------------------------------

# Composer packages (Magento core, Hyvä, React Checkout ...) -> composer install
/vendor/

# Magento core files copied into the root by composer install (magento2-base)
/bin/
/dev/
/lib/
/setup/
/phpserver/
/pub/
/.htaccess
/.htaccess.sample
/.user.ini
/.editorconfig
/.php-cs-fixer.dist.php
/*.sample
/CHANGELOG.md
/COPYING.txt
/LICENSE.txt
/LICENSE_AFL.txt
/SECURITY.md

# Generated by Magento at runtime (cache, logs, compiled code, DB backups)
/generated/
/var/

# Secrets / machine-specific settings - NEVER commit
/app/etc/env.php
/auth.json
.claude/settings.local.json

# Node packages for the Tailwind build -> npm install
node_modules/

# Full-size original images (the resized versions are committed)
/app/design/frontend/Codilar/hyva/web/images/*-original.*

# Editor / OS files
.idea/
.vscode/
*.swp
.DS_Store
